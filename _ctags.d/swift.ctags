--langdef=Swift
--map-Swift=+.swift

--kinddef-Swift=v,variable,variables
--kinddef-Swift=f,function,functions
--kinddef-Swift=c,class,classes
--kinddef-Swift=p,protocol,protocols
--kinddef-Swift=s,struct,structs
--kinddef-Swift=e,enum,enums
--kinddef-Swift=x,extension,extensions

--regex-Swift=/^[[:blank:]]*(var|let)[[:blank:]]+([A-Za-z_][A-Za-z0-9_]*)/\2/v/
--regex-Swift=/^[[:blank:]]*func[[:blank:]]+([A-Za-z_][A-Za-z0-9_]*)[[:blank:]]*\(/\1/f/
--regex-Swift=/^[[:blank:]]*class[[:blank:]]+([A-Za-z_][A-Za-z0-9_]*)/\1/c/
--regex-Swift=/^[[:blank:]]*protocol[[:blank:]]+([A-Za-z_][A-Za-z0-9_]*)/\1/p/
--regex-Swift=/^[[:blank:]]*struct[[:blank:]]+([A-Za-z_][A-Za-z0-9_]*)/\1/s/
--regex-Swift=/^[[:blank:]]*enum[[:blank:]]+([A-Za-z_][A-Za-z0-9_]*)/\1/e/
--regex-Swift=/^[[:blank:]]*extension[[:blank:]]+([A-Za-z_][A-Za-z0-9_]*)/\1/x/
